   "source": [
    "import re\n",
    "\n",
    "text = \"hello \\n\\n## hi \\n## hoi ## bonjour\"\n",
    "\n",
    "parts = re.split(r'(?=\\n\\n## )', text)\n",
    "\n",
    "[print(p) for p in parts]"
   ]
